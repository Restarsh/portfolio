# ---------------------------------------------------------------------------
# Copy to .env.local for development, and add the same keys in Vercel.
# ---------------------------------------------------------------------------

# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL="you@example.com"

# Resend API key (https://resend.com/api-keys). Without it, the contact form
# returns a 503 and shows the visitor your email address instead.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Must be an address on a domain you have verified in Resend.
CONTACT_FROM_EMAIL="portfolio@yourdomain.com"

# Optional: canonical site URL, used for metadata and the sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
